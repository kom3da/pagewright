	<item>
		<title><![CDATA[開店のお知らせ]]></title>
		<link>https://example.jp/2024/05/%e9%96%8b%e5%ba%97%e3%81%ae%e3%81%8a%e7%9f%a5%e3%82%89%e3%81%9b/</link>
		<pubDate>Wed, 01 May 2024 01:00:00 +0000</pubDate>
		<dc:creator><![CDATA[yamada]]></dc:creator>
		<guid isPermaLink="false">https://example.jp/?p=101</guid>
		<description></description>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>5月1日に<strong>やまだ商店</strong>を開店しました。<a href="https://example.jp/company/">会社概要</a>もご覧ください。</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">営業時間</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>平日：7時〜19時<!-- wp:list -->
<ul class="wp-block-list"><!-- wp:list-item -->
<li>水曜日は定休日</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list --></li>
<!-- /wp:list-item -->

<!-- wp:list-item -->
<li>土日：8時〜17時</li>
<!-- /wp:list-item --></ul>
<!-- /wp:list -->

<!-- wp:image {"id":301,"sizeSlug":"large"} -->
<figure class="wp-block-image size-large"><img src="https://example.jp/wp-content/uploads/2024/05/shop-1024x768.jpg" alt="" class="wp-image-301"/></figure>
<!-- /wp:image -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><!-- wp:paragraph -->
<p>おいしいパンを毎日。</p>
<!-- /wp:paragraph --></blockquote>
<!-- /wp:quote -->

<!-- wp:embed {"url":"https://www.youtube.com/watch?v=dQw4w9WgXcQ","type":"video","providerNameSlug":"youtube","responsive":true} -->
<figure class="wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube"><div class="wp-block-embed__wrapper">
https://www.youtube.com/watch?v=dQw4w9WgXcQ
</div></figure>
<!-- /wp:embed -->

<!-- wp:shortcode -->
[contact-form-7 id="5" title="お問い合わせ"]
<!-- /wp:shortcode -->]]></content:encoded>
