# Pagewright の nginx 設定（起動時に ${...} が .env の値に置き換わる）
#
# - 公開サイト：Pagewright が書き出した静的ファイル（/data/site/<サイトID>/）をそのまま配信する。
#   管理画面（app）が止まっていても表示され続ける。
# - 管理画面：app コンテナへ中継する。
# HTTPS は手前の Caddy が受け持つので、ここは HTTP（8080番）だけ。

# Docker の内部DNS。app を作り直してIPが変わっても追従する。
resolver 127.0.0.11 valid=10s ipv6=off;

# 手前の Caddy から見た、閲覧者の本当のIPをログに残す。
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7; # compose.yaml の networks の IPv6
real_ip_header X-Forwarded-For;

# アクセスログにログイン用URLやプレビューURLの合言葉（token）を残さない。
# プレビューURL（/p/<token>/…、最長30日有効）は /p/[redacted]/… に、
# 「token=」を含む問い合わせ（/admin/login/verify?token=… など）は ? 以降を伏せて記録する。
# 中身は公式イメージの main 形式と同じ。
map $request_uri $pagewright_log_uri {
    "~^/p/[^/?]*(?<pw_rest>/[^?]*)?" "/p/[redacted]$pw_rest";
    "~^(?<pw_path>[^?]*)\?(.*&)?token=" "$pw_path?[redacted]";
    default $request_uri;
}
map $http_referer $pagewright_log_referer {
    "~/p/|token=" "[redacted]";
    default $http_referer;
}
log_format pagewright_redacted '$remote_addr - $remote_user [$time_local] '
                               '"$request_method $pagewright_log_uri $server_protocol" '
                               '$status $body_bytes_sent "$pagewright_log_referer" '
                               '"$http_user_agent" "$http_x_forwarded_for"';

# リダイレクト先を「/posts/…/」のまま返す（nginx 自身のポート 8080 や http を付けない）。
absolute_redirect off;

# 知らないドメインへのアクセスには応答しない。
server {
    listen 8080 default_server;
    server_name _;
    access_log /var/log/nginx/access.log pagewright_redacted;
    return 444;
}

# 公開サイト
server {
    listen 8080;
    server_name ${PAGEWRIGHT_SITE_DOMAIN};
    root /data/site/${PAGEWRIGHT_SITE_ID};
    index index.html;
    charset utf-8;
    server_tokens off;
    access_log /var/log/nginx/access.log pagewright_redacted;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml application/rss+xml application/atom+xml image/svg+xml text/plain;

    # 旧URLからのリダイレクト。サイトを書き出すたびに作り直され、
    # 90-pagewright-reload.sh が変更を見つけて nginx を読み込み直す。
    # まだ書き出していないとき（ファイルがないとき）は何もしない（[x] はそのためのワイルドカード。
    # _redirects.nginx の1つだけに当たる）。
    include /data/site/${PAGEWRIGHT_SITE_ID}/_redirects.ngin[x];

    # nginx 用の設定ファイルや隠しファイルは見せない。
    location ^~ /_redirects { return 404; }
    location ~ /\. { return 404; }

    location / {
        try_files $uri $uri/index.html =404;
    }

    # 検索の索引と画像は内容が変わると別名になるとは限らないので、短めにキャッシュする。
    location ^~ /pagefind/ { expires 1h; }
    location ^~ /media/ { expires 1d; }

    error_page 404 /404.html;
}

# 管理画面（app へ中継）
server {
    listen 8080;
    server_name ${PAGEWRIGHT_ADMIN_DOMAIN};
    server_tokens off;
    access_log /var/log/nginx/access.log pagewright_redacted;

    # 画像のアップロードは10MBまで（本体の上限に余裕を持たせる）。
    client_max_body_size 12m;

    location / {
        set $app http://app:8080;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 120s;
    }

    # エラーログは書式を変えられず、要求の行（URL）をそのまま書く。プレビューURL
    # （最長30日有効）とログイン用URLの合言葉を残さないよう、ここだけは重大な
    # エラーしか記録しない。app が止まっているときの 502 は、アクセスログに残る。
    location ^~ /p/ {
        error_log /var/log/nginx/error.log crit;
        set $app http://app:8080;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
    location = /admin/login/verify {
        error_log /var/log/nginx/error.log crit;
        set $app http://app:8080;
        proxy_pass $app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
