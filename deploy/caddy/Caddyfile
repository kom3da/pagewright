# HTTPS の証明書（Let's Encrypt）を自動で取得・更新し、nginx へ中継する。
# ドメインは .env の PAGEWRIGHT_SITE_DOMAIN と PAGEWRIGHT_ADMIN_DOMAIN。
# 2つ目以降のサイトのドメインは PAGEWRIGHT_EXTRA_SITE_DOMAINS（docs/install/second-site.md）。
# 複数あるときは半角スペースで区切る（Caddy のサイトのアドレスには , を使えない）。
#
# アクセスログはわざと出していない（log を書かなければ Caddy は記録しない）。
# ログイン用URL（/admin/login/verify?token=…）とプレビューURL（/p/<token>/…）の
# 合言葉が残るため。アクセスログは token を伏せる nginx のものを見る。

# HSTS：1年間は HTTPS だけで開くようブラウザに伝える（preload と includeSubDomains は付けない。
# 同じドメインの下に HTTPS でないサイトがあっても困らないように）。
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

{$PAGEWRIGHT_SITE_DOMAIN} {$PAGEWRIGHT_EXTRA_SITE_DOMAINS} {
	import hsts
	encode zstd gzip
	reverse_proxy nginx:8080
}

{$PAGEWRIGHT_ADMIN_DOMAIN} {
	import hsts
	reverse_proxy nginx:8080
}
