# Pagewright の設定。このファイルを .env という名前でコピーして書き換える。
#   cp .env.example .env
# .env にはパスワードが入るので、他の人に見せたりGitに入れたりしないこと。

# --- ドメイン -----------------------------------------------------------------
# 公開サイトのドメイン（例: www.example.co.jp）
PAGEWRIGHT_SITE_DOMAIN=www.example.co.jp
# 管理画面のドメイン（例: admin.example.co.jp）。公開サイトとは別のドメインにする
PAGEWRIGHT_ADMIN_DOMAIN=admin.example.co.jp

# --- サイト ID ----------------------------------------------------------------
# `docker compose run --rm cli init ...` で表示された「サイトのID」を書き、
# `docker compose up -d` をもう一度実行する。空のあいだ公開サイトは 404 になる。
PAGEWRIGHT_SITE_ID=

# --- データベースのパスワード -------------------------------------------------
# 英数字だけにする（URLの中に入るため）。次のコマンドで作れる:
#   openssl rand -hex 32
# 最初の起動のあとで変えるときは docs/install.md の「パスワードを変える」を参照。
POSTGRES_PASSWORD=
PAGEWRIGHT_APP_DB_PASSWORD=

# --- メール（ログイン用リンクの送信） -----------------------------------------
# 認証なしで受け付けるSMTPサーバー（ホスト名:ポート）。
# 認証が必要なメール送信サービスを使うときは docs/install.md の「メールの設定」を参照。
PAGEWRIGHT_SMTP_ADDR=smtp.example.co.jp:25
# 差出人
PAGEWRIGHT_MAIL_FROM=ウェブサイト管理 <no-reply@example.co.jp>

# --- そのほか（通常は変えなくてよい） -----------------------------------------
# 使うイメージ。アップデートを自分のタイミングで行うため、版を固定するのがおすすめ
# （例: ghcr.io/kom3da/pagewright:1.2.3）
PAGEWRIGHT_IMAGE=ghcr.io/kom3da/pagewright:latest
TZ=Asia/Tokyo
# サーバーで受けるポート（ほかのソフトと重なるときだけ変える）
PAGEWRIGHT_HTTP_PORT=80
PAGEWRIGHT_HTTPS_PORT=443
