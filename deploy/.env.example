# Pagewright の設定。このファイルを .env という名前でコピーして書き換える。
#   cp .env.example .env
# .env にはパスワードが入るので、他の人に見せたりGitに入れたりしないこと。

# --- ドメイン -----------------------------------------------------------------
# 公開サイトのドメイン（例: www.example.co.jp）
PAGEWRIGHT_SITE_DOMAIN=www.example.co.jp
# 管理画面のドメイン（例: admin.example.co.jp）。公開サイトとは別のドメインにする
PAGEWRIGHT_ADMIN_DOMAIN=admin.example.co.jp
# 2つ目以降のサイトも公開するときだけ、そのドメインを , で区切って書く
# （docs/install/second-site.md）
#PAGEWRIGHT_EXTRA_SITE_DOMAINS=www.example2.co.jp

# --- サイト ID ----------------------------------------------------------------
# `docker compose run --rm cli init ...` で表示された「サイトのID」を書き、
# `docker compose up -d` をもう一度実行する。空のあいだ公開サイトは 404 になる。
PAGEWRIGHT_SITE_ID=

# --- データベースのパスワード -------------------------------------------------
# 英数字だけにする（URLの中に入るため）。次のコマンドで作れる:
#   openssl rand -hex 32
# 最初の起動のあとで変えるときは docs/install/settings.md の「アプリ用のDBパスワードを変える」を参照。
POSTGRES_PASSWORD=
PAGEWRIGHT_APP_DB_PASSWORD=

# --- メール（ログイン用リンクの送信） -----------------------------------------
# SMTPサーバー（ホスト名:ポート）。詳しくは docs/install/mail.md。
PAGEWRIGHT_SMTP_ADDR=smtp.example.co.jp:587
# 認証が必要なときだけ。パスワードは TLS（STARTTLS か implicit）でしか送らない。
PAGEWRIGHT_SMTP_USERNAME=
PAGEWRIGHT_SMTP_PASSWORD=
# 465番ポートなど、最初から TLS で話すサーバーなら implicit。
# STARTTLS に対応していないサーバーには送らないなら starttls（外部の送信サービスではおすすめ）
PAGEWRIGHT_SMTP_TLS=
# 差出人
PAGEWRIGHT_MAIL_FROM=ウェブサイト管理 <no-reply@example.co.jp>

# --- そのほか（通常は変えなくてよい） -----------------------------------------
# 使うイメージの版。アップデートを自分のタイミングで行うため、版まで固定する
# （docs/versioning.md の「Docker イメージのタグ」）。リリースのたびに最新の版に書き換わる
PAGEWRIGHT_IMAGE=ghcr.io/kom3da/pagewright:0.1.0
TZ=Asia/Tokyo
# サイト内検索を使わないときは off にする（docs/install/troubleshooting.md）
#PAGEWRIGHT_PAGEFIND=off
# 1つのサイトに保存できる画像の合計（MB）。0 か空なら上限なし
#PAGEWRIGHT_MEDIA_QUOTA_MB=0
# バックアップの保存先（docs/install/backup.md）。空なら deploy/backups
#PAGEWRIGHT_BACKUP_DIR=/var/backups/pagewright
# サーバーで受けるポート（ほかのソフトと重なるときだけ変える）
PAGEWRIGHT_HTTP_PORT=80
PAGEWRIGHT_HTTPS_PORT=443
